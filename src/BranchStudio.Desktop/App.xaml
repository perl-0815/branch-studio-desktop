<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BranchStudio.Desktop.App">
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="EditorBackground">#151719</Color>
      <Style TargetType="ContentPage"><Setter Property="BackgroundColor" Value="{StaticResource EditorBackground}" /></Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
