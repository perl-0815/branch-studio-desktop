{
  "name": "branch-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3101",
    "build": "next build",
    "start": "node scripts/serve-static.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "predev": "node scripts/copy-monaco.mjs",
    "prebuild": "node scripts/copy-monaco.mjs",
    "format": "prettier --write src scripts tests *.ts *.mjs *.json README.md",
    "test:runtime": "dotnet test runtime/BranchStudio.Runtime.Tests/BranchStudio.Runtime.Tests.csproj --nologo",
    "assets:icons": "node scripts/generate-icons.mjs",
    "assets:preview": "node scripts/generate-preview.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "monaco-editor": "^0.57.0",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "packageManager": "pnpm@10.34.5",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
